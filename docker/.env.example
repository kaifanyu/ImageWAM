# Per-machine Docker settings. Copy to docker/.env on each host:
#
#   printf 'IMAGEWAM_UID=%s\nIMAGEWAM_GID=%s\n' "$(id -u)" "$(id -g)" > docker/.env
#
# Compose loads docker/.env automatically. docker/.env is gitignored; this
# example file is the one that gets committed.

# Your host uid/gid. Files the container writes into the bind-mounted repo are
# owned by these, and the uid is baked into the image as a passwd entry.
# Changing these requires a rebuild, not just a re-run.
IMAGEWAM_UID=3041
IMAGEWAM_GID=3041

# "host" is required on daemons with userns-remap enabled (this GPU server has
# it; check with `docker info | grep userns`). On a normal daemon -- most laptops
# and single-user boxes -- leave it, or set "private" for stock isolation.
IMAGEWAM_USERNS=host

# Defaults to the directory containing this repo. Set an absolute path only if
# the checkout you want to mount lives elsewhere (e.g. code on NFS, data on a
# local NVMe disk).
# IMAGEWAM_REPO=/data3/kaifany/ImageWAM

# Raise if DataLoader workers still hit "bus error" with many workers.
IMAGEWAM_SHM_SIZE=16gb

# Hugging Face cache. The FLUX.2 scripts pull Qwen/Qwen3-4B (~7.6GB) from here;
# mounting your existing host cache avoids re-downloading it. Give the REAL path
# if ~/.cache/huggingface is a symlink (it is on this server).
IMAGEWAM_HF_CACHE=/data3/kaifany/cache/huggingface

# diffusers version. Leave EMPTY for the FLUX baseline (uses vendored flux2, not
# diffusers). Set to 0.35.1+ ONLY if you want the Qwen-Image-Edit baseline
# (IMAGE_EDITOR=qwen), which needs QwenImageEditPipeline. Changing this requires
# a rebuild. NOTE: Qwen-Image-Edit is ~20B params -- not usable on an 11GB card.
# IMAGEWAM_DIFFUSERS_VERSION=0.35.1
