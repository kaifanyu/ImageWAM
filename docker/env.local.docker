# Container-side replacement for .env.local, mounted read-only over it.
#
# A host .env.local holds host-absolute paths, which do not exist inside the
# container. Everything below is rewritten against the single container path
# /workspace/ImageWAM, and the interpreter/venv paths point at the image's venv
# rather than the repo's ./.venv.

PYTHON_BIN=/opt/imagewam/.venv/bin/python
PYTORCH_CUDA_ALLOC_CONF=expandable_segments:True

DATA_ROOT=/workspace/ImageWAM/data/libero_mujoco3.3.2
OUTPUT_ROOT=/workspace/ImageWAM/runs
MODEL_ROOT=/workspace/ImageWAM/checkpoints

FLUX2_SRC=/workspace/ImageWAM/third_party/flux2
FLUX2_MODEL_PATH=/workspace/ImageWAM/checkpoints/flux2/FLUX.2-klein-base-4B/flux-2-klein-base-4b.safetensors
FLUX2_AE_MODEL_PATH=/workspace/ImageWAM/checkpoints/flux2/FLUX.2-dev/ae.safetensors

# Base-editor baseline (scripts/flux2/run_baseline_edit_traj.sh). Variant-specific
# base weights: the baseline picks FLUX2_MODEL_PATH_<VARIANT> by IMAGE_EDITOR, so
# both can be set at once. Download with: DOWNLOAD_9B=true bash scripts/flux2/prepare_flux2_files.sh
FLUX2_MODEL_PATH_4B=/workspace/ImageWAM/checkpoints/flux2/FLUX.2-klein-base-4B/flux-2-klein-base-4b.safetensors
FLUX2_MODEL_PATH_9B=/workspace/ImageWAM/checkpoints/flux2/FLUX.2-klein-base-9B/flux-2-klein-base-9b.safetensors
# flux9b uses Qwen3-8B as its text encoder (vs Qwen3-4B for 4b); FLUX2_QWEN3_MODEL_SPEC
# is auto-selected per variant, override here only to pin a specific one.
# Qwen-Image-Edit baseline (IMAGE_EDITOR=qwen); needs a DIFFUSERS_VERSION>=0.35 image.
QWEN_IMAGE_EDIT_MODEL=Qwen/Qwen-Image-Edit
QWEN_CPU_OFFLOAD=true

CKPT_PATH=${CKPT_PATH:-/workspace/ImageWAM/checkpoints/imagewam_release/libero/flux2_klein_4b/model.pt}
DATASET_STATS_PATH=${DATASET_STATS_PATH:-/workspace/ImageWAM/checkpoints/imagewam_release/libero/flux2_klein_4b/dataset_stats.json}

# LIBERO eval launches worker processes that re-activate the env by sourcing this.
LIBERO_WORKER_ENV_SOURCE=/opt/imagewam/.venv/bin/activate
PYTHONPATH=/workspace/ImageWAM/third_party/LIBERO
