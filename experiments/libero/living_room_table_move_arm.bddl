(define (problem LIBERO_Living_Room_Tabletop_Manipulation)
  (:domain robosuite)
  (:language move the robot arm across the living room table while keeping the gripper open)

  (:regions
    ; This transparent table site remains below LIBERO's Up threshold. Endpoint
    ; success is evaluated numerically by sample_endpoint_trajectories.py.
    (never_success_region
      (:target living_room_table)
      (:ranges ((0.00 0.00 0.01 0.01)))
    )
  )

  (:fixtures
    living_room_table - living_room_table
  )

  (:objects)
  (:obj_of_interest)
  (:init)
  (:goal
    (And (Up living_room_table_never_success_region))
  )
)
